#!/bin/bash
# Runs the brb CLI from whichever plugin version is currently installed, so the
# command and the hooks are always the same code. Survives plugin updates.
d=$(ls -d "$HOME"/.claude/plugins/cache/*/brb/*/ 2>/dev/null | sort -V | tail -1)
if [ -z "$d" ]; then
  echo "brb plugin is not installed. Run: claude plugin install brb@brb" >&2
  exit 1
fi
exec "$d/brb" "$@"
